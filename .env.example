# AGRISENSE ENVIRONMENT CONFIGURATION EXAMPLE

# Server Configuration
PORT=3001
NODE_ENV=development

# Google Gemini AI Integration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Supabase / PostgreSQL Configuration
# Optional: Required when connecting to remote Supabase instance
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Weather API Configuration
# Open-Meteo is free and requires no API key by default.
# Custom base URL or enterprise key (optional):
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Agricultural Market API Configuration
# Integration status mode: LIVE | DEMO | NOT_CONFIGURED
MARKET_API_MODE=DEMO
MARKET_API_KEY=
